{
  "name": "family-agenda-imap",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The IMAP mailbox Source Type of Family Agenda as a stateless plugin container.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node26 --format=esm --outfile=dist/main.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "pnpm build && node dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@family-agenda/plugin-contract": "github:artkoenig/family-agenda#2a1d62e7b5e5004b72219db7de3b6e46faa80085&path:/packages/plugin-contract",
    "@family-agenda/plugin-kit": "github:artkoenig/family-agenda#2a1d62e7b5e5004b72219db7de3b6e46faa80085&path:/packages/plugin-kit",
    "imapflow": "2.10.0",
    "mailparser": "3.14.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.0.0",
    "esbuild": "0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
